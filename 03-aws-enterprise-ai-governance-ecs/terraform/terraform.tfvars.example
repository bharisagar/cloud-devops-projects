aws_region   = "ap-south-1"
project_name = "enterprise-ai-governance-ecs"
environment  = "sandbox"
owner        = "barisagar"
cost_center  = "learning-ai-governance"

ai_provider     = "demo"
app_policy_mode = "monitor"

# After building and pushing the image, either leave this empty to use the
# project ECR repository with :latest or paste the full image URI.
container_image = ""

desired_count  = 1
task_cpu       = 512
task_memory    = 1024
min_task_count = 1
max_task_count = 4

# Production baseline for this architecture: Amazon Nova Pro through APAC cross-region inference.
# Use Nova Lite for cost-optimized testing, or Claude Sonnet 4.6 for advanced long-context reasoning.
bedrock_model_id = "apac.amazon.nova-pro-v1:0"

# Use this only when ai_provider = "sagemaker".
# For low-cost evidence, use the custom smoke endpoint on ml.m5.large.
# For LLM evidence, use a quota-approved JumpStart endpoint such as Gemma 3 1B on ml.g5.2xlarge
# or Llama3 8B SEA-Lion v2.1 on ml.g5.4xlarge.
sagemaker_endpoint_name = ""

enable_bedrock_invocation_logging = false

# Optional emails. Leave blank for no notifications.
alarm_email        = ""
budget_alert_email = ""
monthly_budget_usd = "20"
